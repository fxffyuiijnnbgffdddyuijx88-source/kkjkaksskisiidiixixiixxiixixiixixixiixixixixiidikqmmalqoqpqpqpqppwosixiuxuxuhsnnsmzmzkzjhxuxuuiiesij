                        <span>• কষ্ট </span>
                    </div>
                </div>
            </div>

            <div class="header-controls">
                <button class="btn btn-secondary" onclick="manualRefresh()"><i class="fa-solid fa-rotate"></i> Refresh</button>
                <button class="btn btn-primary" onclick="openAddModal()"><i class="fa-solid fa-plus"></i> Add Account</button>
                <button class="btn btn-secondary" onclick="openBulkModal()"><i class="fa-solid fa-layer-group"></i> Bulk Add</button>
                <div class="target-ctl" title="Auto-off level for ALL accounts">
                    <i class="fa-solid fa-bullseye" style="color:#00e676"></i>
