                if (data.status === 'ok') {
                    showToast(`Account ${uid} permanently removed.`, 'info');
                    // Remove card from DOM immediately
                    const card = document.getElementById(`acc-card-${uid}`);
                    if (card) card.remove();
                    fetchStats();
                } else {
                    showToast('Error removing account: ' + (data.error || 'Unknown'), 'error');
