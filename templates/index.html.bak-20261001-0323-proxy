        // Match History helpers
        const openHistUids = new Set();

        function toggleMatchHistory(uid) {
            const el = document.getElementById('mh-' + uid);
            if (!el) return;
            const isOpen = el.style.display !== 'none';
            el.style.display = isOpen ? 'none' : 'block';
            if (isOpen) openHistUids.delete(String(uid)); else openHistUids.add(String(uid));
        }

        function renderMatchHistory(hist) {
            if (!hist || !hist.length) return '<div class="mh-empty">No matches recorded yet.</div>';
            return [...hist].reverse().slice(0, 5).map(m => {
                const dur = formatDuration(m.duration_sec || 0);
                const exp = m.pending_exp ? '<span style="color:var(--text-dim)">...</span>' : ('+' + (m.exp_gained || 0).toLocaleString());
                return `<div class="mh-row"><span class="mh-time">${escapeHtml(m.start || '')} → ${escapeHtml(m.end || '')}</span><span class="mh-dur">${dur}</span><span class="exp-gained-highlight mh-exp">${exp}</span></div>`;
            }).join('');
        }

        // UDP packet monitor strip (per account card)
        function udpStrip(u) {
            if (!u || (!u.sent && !u.recv)) return '<div class="udp-strip"><div class="udp-line"><span class="u-k">UDP</span><span>No packets yet</span></div></div>';
            const order = ['ping', 'hello', 'thunder', 'sharma', 'ack', 'reply'];
            const sk = u.sent_kinds || {};
            const sentParts = order.filter(k => sk[k]).map(k => `${k} ${(sk[k] || 0).toLocaleString()}`);
            Object.keys(sk).filter(k => !order.includes(k)).forEach(k => sentParts.push(`${k} ${(sk[k] || 0).toLocaleString()}`));
            const rt = u.recv_types || {};
            const recvParts = Object.entries(rt).sort((a, b) => b[1] - a[1]).slice(0, 6).map(([k, v]) => `${k} ${(v || 0).toLocaleString()}`);
            const ago = (u.last_recv_ago == null) ? '—' : (u.last_recv_ago + 's ago');
            const warn = u.silent ? ' <span class="udp-warn">⚠ SILENT</span>' : '';
            const kb = b => b >= 1048576 ? (b / 1048576).toFixed(1) + ' MB' : Math.round(b / 1024) + ' KB';
            return `<div class="udp-strip" title="Bytes ↑${kb(u.bytes_sent || 0)} ↓${kb(u.bytes_recv || 0)}">
                <div class="udp-line"><span class="u-k">UDP</span><span class="u-v">↑${(u.sent || 0).toLocaleString()}</span><span class="u-v">↓${(u.recv || 0).toLocaleString()}</span><span>${u.pps || 0} pkt/s</span><span>last ${ago}</span>${warn}</div>
                <div class="udp-line"><span class="u-k">sent</span><span>${sentParts.join(' · ') || '—'}</span></div>
                <div class="udp-line"><span class="u-k">recv</span><span>${recvParts.join(' · ') || '—'}</span></div>
            </div>`;
        }

        // Delete Account
